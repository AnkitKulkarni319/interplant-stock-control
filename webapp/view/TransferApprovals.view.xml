
<mvc:View
    controllerName="interplant.stock.storemanager.storemanager.controller.TransferApprovals"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        title="Transfer Approvals"
        showNavButton="true"
        navButtonPress=".onBack">

        <content>
            <VBox class="sapUiMediumMargin">

                <Toolbar>
                    <Title
                        text="Pending Transfer Requests"
                        level="H2" />

                    <ToolbarSpacer />

                    <Button
                        text="Refresh"
                        icon="sap-icon://refresh"
                        press=".onRefresh" />
                </Toolbar>

                <Table
                    id="approvalTable"
                    items="{/TransferRequests}"
                    growing="true"
                    growingScrollToLoad="true"
                    updateFinished=".onApprovalsUpdateFinished"
                    noDataText="No pending transfer requests">

                    <columns>
                        <Column>
                            <Text text="Transfer Number" />
                        </Column>

                        <Column>
                            <Text text="Source Plant" />
                        </Column>

                        <Column>
                            <Text text="Source Storage Location" />
                        </Column>

                        <Column>
                            <Text text="Destination Plant" />
                        </Column>

                        <Column>
                            <Text text="Destination Storage Location" />
                        </Column>

                        <Column>
                            <Text text="Status" />
                        </Column>

                        <Column>
                            <Text text="Action" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{transferNumber}" />
                                <Text text="{sourcePlant_ID}" />
                                <Text text="{sourceStorageLocation_ID}" />
                                <Text text="{destinationPlant_ID}" />
                                <Text text="{destinationStorageLocation_ID}" />

                                <ObjectStatus
                                    text="{status}"
                                    state="Warning" />

                                <Button
                                    text="View Details"
                                    icon="sap-icon://detail-view"
                                    press=".onViewDetails" />
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>
            </VBox>
        </content>

    </Page>

</mvc:View>
